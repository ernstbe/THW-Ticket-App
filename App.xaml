<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:THWTicketApp"
             xmlns:converters="clr-namespace:THWTicketApp.Converters"
             x:Class="THWTicketApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:FilterColorConverter x:Key="FilterColorConverter"/>

            <!-- Filter Chip Style -->
            <Style x:Key="FilterChipStyle" TargetType="Button">
                <Setter Property="HeightRequest" Value="35"/>
                <Setter Property="Padding" Value="15,5"/>
                <Setter Property="CornerRadius" Value="17"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
