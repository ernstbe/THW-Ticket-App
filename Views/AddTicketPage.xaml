<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             x:Class="THWTicketApp.Views.AddTicketPage"
             x:DataType="viewmodels:AddTicketViewModel"
             Title="Ticket erstellen">

    <ScrollView BackgroundColor="{StaticResource PageBackground}">
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Page Header -->
            <Label Text="Ticket erstellen"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource THWBlueDark}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,5"/>

            <!-- Subject Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Betreff"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10,0"
                            BackgroundColor="{StaticResource PageBackground}">
                        <Entry Placeholder="Betreff"
                               Text="{Binding Subject}"
                               MaxLength="200"
                               BackgroundColor="Transparent"/>
                    </Border>

                    <Label Text="Beschreibung"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10"
                            BackgroundColor="{StaticResource PageBackground}">
                        <Editor Placeholder="Bitte sei so spezifisch wie möglich. Füge alle Details hinzu, die relevant sein könnten."
                                Text="{Binding Issue}"
                                HeightRequest="120"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>
            </Frame>

            <!-- Classification Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Typ &amp; Priorität"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <Label Text="Typ"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Picker Title="Option auswählen"
                            ItemsSource="{Binding TicketTypes}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedType}"/>

                    <Label Text="Priorität"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Picker Title="Option auswählen"
                            ItemsSource="{Binding Priorities}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPriority}"/>

                    <Label Text="Gruppe"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Picker Title="Option auswählen"
                            ItemsSource="{Binding Groups}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedGroup}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Assignment Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Zuweisen an"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <Label Text="Zuständig"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Picker Title="Auswählen"
                            ItemsSource="{Binding Users}"
                            ItemDisplayBinding="{Binding Fullname}"
                            SelectedItem="{Binding SelectedAssignee}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding StatusColor}"
                   IsVisible="{Binding HasStatusMessage}"
                   HorizontalTextAlignment="Center"
                   FontSize="14"/>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource THWBlue}"/>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,5,0,20">
                <Button Grid.Column="0"
                        Text="Abbrechen"
                        x:Name="CancelBtn"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1"
                        Text="Erstellen"
                        x:Name="CreateBtn"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CreateTicketCommand}"
                        IsEnabled="{Binding CanCreate}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
