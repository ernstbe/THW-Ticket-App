<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:THWTicketApp.Models"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             x:Class="THWTicketApp.TicketPage"
             x:DataType="viewmodels:TicketPageViewModel"
             NavigationPage.HasBackButton="False"
             Title="Tickets"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">

    <VerticalStackLayout Padding="15" Spacing="12">

        <!-- Header with search and buttons -->
        <HorizontalStackLayout Spacing="10">
            <SearchBar Placeholder="Tickets durchsuchen..." Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}"
                       BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       HorizontalOptions="FillAndExpand"/>
            <Button Text="+" FontSize="22" FontAttributes="Bold"
                    WidthRequest="45" HeightRequest="45" CornerRadius="22"
                    Command="{Binding ShowAddTicketCommand}"
                    BackgroundColor="{DynamicResource Primary}" TextColor="White"/>
            <Button Text="⚙" FontSize="18"
                    WidthRequest="45" HeightRequest="45" CornerRadius="22"
                    Command="{Binding ShowSettingsCommand}"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
        </HorizontalStackLayout>

        <!-- Filter Buttons -->
        <HorizontalStackLayout Spacing="8">
            <Button Text="Alle" Command="{Binding FilterCommand}" CommandParameter="all"
                    CornerRadius="15" Padding="14,6" FontSize="13">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveFilter}" Value="all">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#333, Dark=White}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button Text="Offen" Command="{Binding FilterCommand}" CommandParameter="open"
                    CornerRadius="15" Padding="14,6" FontSize="13">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveFilter}" Value="open">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#333, Dark=White}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button Text="In Arbeit" Command="{Binding FilterCommand}" CommandParameter="pending"
                    CornerRadius="15" Padding="14,6" FontSize="13">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveFilter}" Value="pending">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#333, Dark=White}"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button Text="Erledigt" Command="{Binding FilterCommand}" CommandParameter="closed"
                    CornerRadius="15" Padding="14,6" FontSize="13">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ActiveFilter}" Value="closed">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#333, Dark=White}"/>
                    </Style>
                </Button.Style>
            </Button>
        </HorizontalStackLayout>

        <!-- Loading/Status -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           Color="{DynamicResource Primary}" HeightRequest="30"/>
        <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="Gray"
               HorizontalOptions="Center" IsVisible="{Binding HasStatusMessage}"/>

        <!-- Ticket List - fills remaining space -->
        <CollectionView x:Name="TicketsCollectionView"
                        ItemsSource="{Binding FilteredTickets}"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand">
            <CollectionView.EmptyView>
                <Label Text="Keine Tickets gefunden" FontSize="16" HorizontalOptions="Center"
                       VerticalOptions="Center" TextColor="Gray" Margin="0,50"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Ticket">
                    <Frame Margin="0,5" Padding="14" CornerRadius="10"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}">
                        <VerticalStackLayout Spacing="6">
                            <!-- Header: ID and Status -->
                            <HorizontalStackLayout>
                                <Label Text="{Binding Uid, StringFormat='#{0}'}" FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource Primary}" HorizontalOptions="StartAndExpand"/>
                                <Frame Padding="8,4" CornerRadius="10" BorderColor="Transparent"
                                       BackgroundColor="{Binding Status.HtmlColor}" HasShadow="False">
                                    <Label Text="{Binding Status.Name}" FontSize="11" TextColor="White"/>
                                </Frame>
                            </HorizontalStackLayout>

                            <!-- Subject -->
                            <Label Text="{Binding Subject}" FontAttributes="Bold" FontSize="16"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                            <!-- Info row -->
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding Type.Name}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Priority.Name}" FontSize="12" TextColor="{Binding Priority.HtmlColor}"/>
                                <Label Text="{Binding Assignee.Fullname, TargetNullValue='—'}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd.MM.yy}'}" FontSize="12" TextColor="Gray"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
