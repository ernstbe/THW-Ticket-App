<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:THWTicketApp.Models"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             xmlns:controls="clr-namespace:THWTicketApp.Controls"
             xmlns:data="clr-namespace:THWTicketApp.Data"
             x:Class="THWTicketApp.TicketPage"
             x:DataType="viewmodels:TicketPageViewModel"
             Title="Tickets">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- Header with THW-blue background -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBackground}, Dark={StaticResource HeaderBackgroundDark}}"
              Padding="15,10"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
            <!-- Search bar on white background -->
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSurfaceLight}}"
                    Padding="5,0">
                <SearchBar Placeholder="Suchen..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent"
                           CancelButtonColor="{StaticResource THWBlue}"/>
            </Border>
            <!-- Filter toggle button -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <ImageButton Source="filter.png"
                             WidthRequest="36"
                             HeightRequest="36"
                             Command="{Binding ToggleFilterPanelCommand}"
                             BackgroundColor="Transparent"/>
                <!-- Filter count badge -->
                <Frame IsVisible="{Binding HasActiveFilters}"
                       BackgroundColor="{StaticResource Danger}"
                       CornerRadius="8"
                       Padding="4,1"
                       HasShadow="False"
                       BorderColor="Transparent"
                       HorizontalOptions="End"
                       VerticalOptions="Start"
                       Margin="0,-2,-2,0">
                    <Label Text="{Binding ActiveFilterCount}"
                           TextColor="White"
                           FontSize="9"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </Frame>
            </Grid>
            <!-- Scanner button -->
            <ImageButton Grid.Column="2"
                         Source="scan.png"
                         WidthRequest="36"
                         HeightRequest="36"
                         Command="{Binding ShowScannerCommand}"
                         BackgroundColor="Transparent"
                         Margin="4,0,0,0"/>
            <!-- Export button -->
            <Border Grid.Column="3"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    BackgroundColor="Transparent"
                    Padding="4"
                    Margin="4,0,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExportTicketsCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="CSV"
                       TextColor="White"
                       FontSize="11"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"/>
            </Border>
            <!-- Live indicator -->
            <Border Grid.Column="4"
                    IsVisible="{Binding IsRealtimeConnected}"
                    StrokeShape="RoundRectangle 4"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource SuccessGreen}"
                    WidthRequest="8"
                    HeightRequest="8"
                    VerticalOptions="Center"
                    Margin="8,0,0,0"/>
            <ImageButton Grid.Column="5"
                         Source="settings.png"
                         WidthRequest="40"
                         HeightRequest="40"
                         Command="{Binding ShowSettingsCommand}"
                         BackgroundColor="Transparent"
                         Margin="5,0,0,0"/>
        </Grid>

        <!-- Filter Chips + Sort -->
        <VerticalStackLayout Grid.Row="1">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="15,10,15,5"
                                       Spacing="8">
                    <Button Text="Alle"
                            Style="{StaticResource FilterChipStyle}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="all"
                            BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=all}"/>
                    <Button Text="Offen"
                            Style="{StaticResource FilterChipStyle}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="open"
                            BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=open}"/>
                    <Button Text="Ausstehend"
                            Style="{StaticResource FilterChipStyle}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="pending"
                            BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=pending}"/>
                    <Button Text="Geschlossen"
                            Style="{StaticResource FilterChipStyle}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="closed"
                            BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=closed}"/>
                    <BoxView WidthRequest="1" HeightRequest="20"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                             VerticalOptions="Center"/>
                    <Button Text="&#x2B50; Favoriten"
                            Style="{StaticResource FilterChipStyle}"
                            Command="{Binding ToggleFavoritesFilterCommand}"
                            BackgroundColor="{Binding ShowOnlyFavorites, Converter={StaticResource BoolToFavoriteColorConverter}}"/>
                    <Button Text="&#x23F0; Überfällig"
                            Style="{StaticResource FilterChipStyle}"
                            Command="{Binding ToggleOverdueFilterCommand}"
                            BackgroundColor="{Binding ShowOnlyOverdue, Converter={StaticResource BoolToOverdueColorConverter}}"/>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Advanced Filter Panel (collapsible) -->
            <Frame IsVisible="{Binding IsFilterPanelVisible}"
                   Style="{StaticResource CardStyle}"
                   Margin="10,5"
                   Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Erweiterte Filter"
                               Style="{StaticResource SectionHeaderStyle}"
                               FontSize="15"
                               Margin="0"/>
                        <Button Grid.Column="1"
                                Text="Zurücksetzen"
                                FontSize="11"
                                Padding="8,4"
                                CornerRadius="12"
                                HeightRequest="28"
                                MinimumHeightRequest="28"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                Command="{Binding ClearAllFiltersCommand}"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <!-- Priority Filter -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Priorität:"
                               Style="{StaticResource FormLabelStyle}"
                               VerticalOptions="Center" Margin="0"/>
                        <Picker Grid.Column="1"
                                Title="Alle"
                                ItemsSource="{Binding AvailablePriorities}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedPriorityFilter}"
                                FontSize="13"/>
                    </Grid>

                    <!-- Type Filter -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Typ:"
                               Style="{StaticResource FormLabelStyle}"
                               VerticalOptions="Center" Margin="0"/>
                        <Picker Grid.Column="1"
                                Title="Alle"
                                ItemsSource="{Binding AvailableTypes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedTypeFilter}"
                                FontSize="13"/>
                    </Grid>

                    <!-- Group Filter -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Gruppe:"
                               Style="{StaticResource FormLabelStyle}"
                               VerticalOptions="Center" Margin="0"/>
                        <Picker Grid.Column="1"
                                Title="Alle"
                                ItemsSource="{Binding AvailableGroups}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedGroupFilter}"
                                FontSize="13"/>
                    </Grid>

                    <!-- My Tickets Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Nur meine Tickets"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               FontSize="13"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ShowOnlyMyTickets}"/>
                    </Grid>

                    <!-- Favorites Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Nur Favoriten"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               FontSize="13"
                               VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ShowOnlyFavorites}"/>
                    </Grid>

                    <!-- Date Range -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Von:"
                               Style="{StaticResource FormLabelStyle}"
                               VerticalOptions="Center" Margin="0"/>
                        <DatePicker Grid.Column="1"
                                    Date="{Binding DateFrom}"
                                    FontSize="12"
                                    Format="dd.MM.yyyy"/>
                        <Label Grid.Column="2" Text="Bis:"
                               Style="{StaticResource FormLabelStyle}"
                               VerticalOptions="Center" Margin="0"/>
                        <DatePicker Grid.Column="3"
                                    Date="{Binding DateTo}"
                                    FontSize="12"
                                    Format="dd.MM.yyyy"/>
                    </Grid>

                    <!-- Saved Filters -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"
                             Margin="0,5"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Gespeicherte Filter"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Speichern"
                                FontSize="11"
                                Padding="8,4"
                                CornerRadius="12"
                                HeightRequest="28"
                                MinimumHeightRequest="28"
                                BackgroundColor="{StaticResource THWBlue}"
                                TextColor="White"
                                Command="{Binding SaveCurrentFilterCommand}"/>
                    </Grid>
                    <CollectionView ItemsSource="{Binding SavedFilters}"
                                    HeightRequest="80">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Text="Keine gespeicherten Filter"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:SavedFilter">
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource THWBlue}"
                                        StrokeThickness="1"
                                        Padding="10,6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource THWBlueSurface}, Dark={StaticResource THWBlueSurfaceDark}}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource THWBlue}"/>
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="Anwenden"
                                                   FontSize="10"
                                                   TextColor="{StaticResource THWBlue}"
                                                   TextDecorations="Underline">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketPageViewModel}}, Path=ApplySavedFilterCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Text="X"
                                                   FontSize="10"
                                                   TextColor="{StaticResource Danger}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketPageViewModel}}, Path=DeleteSavedFilterCommand}"
                                                                          CommandParameter="{Binding}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Sort Picker -->
            <Grid Padding="15,0,15,5" ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="Sortierung:"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       VerticalOptions="Center"/>
                <Picker Grid.Column="1"
                        x:Name="SortPicker"
                        FontSize="12"
                        SelectedIndexChanged="OnSortChanged"
                        VerticalOptions="Center">
                    <Picker.Items>
                        <x:String>Neueste zuerst</x:String>
                        <x:String>Älteste zuerst</x:String>
                        <x:String>Zuletzt aktualisiert</x:String>
                        <x:String>Priorität</x:String>
                        <x:String>Fälligkeitsdatum</x:String>
                        <x:String>Betreff A-Z</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>
        </VerticalStackLayout>

        <!-- Ticket List with Pull-to-Refresh -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshTicketsCommand}"
                     RefreshColor="{StaticResource THWBlue}">
            <CollectionView x:Name="TicketsCollectionView"
                            ItemsSource="{Binding FilteredTickets}"
                            SelectionMode="Single"
                            EmptyView="Keine Ergebnisse">

                <!-- Loading indicator -->
                <CollectionView.Header>
                    <controls:SkeletonView IsVisible="{Binding IsLoading}"
                                            SkeletonType="list"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ticket">
                        <SwipeView>
                            <!-- Swipe Right: Assign to me / Favorite -->
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Mir zuweisen"
                                               BackgroundColor="{StaticResource THWBlue}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketPageViewModel}}, Path=AssignToMeCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Favorit"
                                               BackgroundColor="{StaticResource WarningOrange}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketPageViewModel}}, Path=ToggleFavoriteCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <!-- Swipe Left: Close ticket -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Schließen"
                                               BackgroundColor="{StaticResource StatusClosed}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketPageViewModel}}, Path=CloseTicketCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Ticket Card with left priority bar (Trudesk-style) -->
                            <Border Margin="10,5"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                                <Border.Shadow>
                                    <Shadow Brush="Black"
                                            Offset="0,2"
                                            Radius="6"
                                            Opacity="0.1"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="5,*">
                                    <!-- Left Priority Color Bar -->
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{Binding Priority.HtmlColor}"
                                             WidthRequest="5"/>

                                    <!-- Ticket Content -->
                                    <Grid Grid.Column="1"
                                          Padding="15"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto">

                                        <!-- Title -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Subject}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                                               LineBreakMode="TailTruncation"/>

                                        <!-- Status Badge -->
                                        <Frame Grid.Row="0" Grid.Column="1"
                                               BackgroundColor="{Binding Status.HtmlColor}"
                                               Padding="10,4"
                                               CornerRadius="12"
                                               HasShadow="False"
                                               BorderColor="Transparent">
                                            <Label Text="{Binding Status.Name}"
                                                   TextColor="White"
                                                   FontSize="11"
                                                   FontAttributes="Bold"/>
                                        </Frame>

                                        <!-- Type and Priority -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2"
                                                               Spacing="15"
                                                               Margin="0,8,0,0">
                                            <Label TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" FontSize="13">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Typ: " FontAttributes="Bold"/>
                                                        <Span Text="{Binding Type.Name}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label TextColor="{Binding Priority.HtmlColor}" FontSize="13">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Priorität: " FontAttributes="Bold"/>
                                                        <Span Text="{Binding Priority.Name}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </HorizontalStackLayout>

                                        <!-- Assignee and Date -->
                                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                                             Spacing="3"
                                                             Margin="0,5,0,0">
                                            <HorizontalStackLayout Spacing="15">
                                                <Label TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" FontSize="12">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Zuständig: "/>
                                                            <Span Text="{Binding Assignee.Fullname, TargetNullValue='Kein Benutzer zugewiesen'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" FontSize="12">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Erstellt: "/>
                                                            <Span Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </HorizontalStackLayout>
                                            <!-- Due Date (only visible when set) -->
                                            <Label IsVisible="{Binding DueDate, Converter={StaticResource DueDateVisibilityConverter}}"
                                                   TextColor="{Binding DueDate, Converter={StaticResource DueDateColorConverter}}"
                                                   FontSize="12"
                                                   FontAttributes="Bold">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Fällig: "/>
                                                        <Span Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Tags -->
                                        <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2"
                                                               Spacing="5"
                                                               Margin="0,5,0,0"
                                                               BindableLayout.ItemsSource="{Binding Tags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:Tag">
                                                    <Frame Padding="6,2"
                                                           CornerRadius="8"
                                                           HasShadow="False"
                                                           BorderColor="{StaticResource THWBlueLight}"
                                                           BackgroundColor="{AppThemeBinding Light={StaticResource THWBlueSurface}, Dark={StaticResource THWBlueSurfaceDark}}">
                                                        <Label Text="{Binding Name}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource THWBlue}"/>
                                                    </Frame>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Bulk Action Toolbar -->
        <Frame Grid.Row="2"
               IsVisible="{Binding IsBulkSelectMode}"
               BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBackground}, Dark={StaticResource HeaderBackgroundDark}}"
               Padding="10"
               CornerRadius="0"
               BorderColor="Transparent"
               VerticalOptions="End">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="14"
                       VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SelectedCount}"/>
                            <Span Text=" ausgewählt"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button Grid.Column="2"
                        Text="Alle"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="12"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        BackgroundColor="White"
                        TextColor="{StaticResource THWBlue}"
                        Command="{Binding SelectAllTicketsCommand}"/>
                <Button Grid.Column="3"
                        Text="Zuweisen"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="12"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        BackgroundColor="{StaticResource SuccessGreen}"
                        TextColor="White"
                        Command="{Binding BulkAssignToMeCommand}"/>
                <Button Grid.Column="4"
                        Text="Schließen"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="12"
                        HeightRequest="32"
                        MinimumHeightRequest="32"
                        BackgroundColor="{StaticResource Danger}"
                        TextColor="White"
                        Command="{Binding BulkCloseCommand}"/>
            </Grid>
        </Frame>

        <!-- Floating Action Buttons -->
        <!-- Bulk Select Toggle Button -->
        <Button Grid.Row="2"
                Text="&#x2611;"
                FontSize="20"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Command="{Binding ToggleBulkSelectModeCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                HorizontalOptions="End"
                VerticalOptions="End"
                IsVisible="{Binding IsBulkSelectMode, Converter={StaticResource InverseBoolConverter}}"
                Margin="0,0,80,20">
            <Button.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.25"/>
            </Button.Shadow>
        </Button>
        <Button Grid.Row="2"
                Text="+"
                FontSize="24"
                FontAttributes="Bold"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Command="{Binding ShowAddTicketCommand}"
                BackgroundColor="{StaticResource THWBlue}"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                IsVisible="{Binding IsBulkSelectMode, Converter={StaticResource InverseBoolConverter}}"
                Margin="0,0,20,20">
            <Button.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.25"/>
            </Button.Shadow>
        </Button>
        <!-- Cancel bulk select button -->
        <Button Grid.Row="2"
                Text="&#x2716;"
                FontSize="20"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Command="{Binding ToggleBulkSelectModeCommand}"
                BackgroundColor="{StaticResource Danger}"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                IsVisible="{Binding IsBulkSelectMode}"
                Margin="0,0,20,70">
            <Button.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.25"/>
            </Button.Shadow>
        </Button>

        <!-- Status Bar -->
        <VerticalStackLayout Grid.Row="3">
            <!-- Pending Sync Indicator -->
            <Frame Padding="8"
                   IsVisible="{Binding HasPendingActions}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource WarningBannerBg}, Dark={StaticResource WarningBannerBgDark}}"
                   CornerRadius="0"
                   BorderColor="Transparent">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="&#x1F504;" FontSize="14"/>
                    <Label TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                           FontAttributes="Bold"
                           FontSize="13">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding PendingActionsCount}"/>
                                <Span Text=" ausstehende Aktion(en) - Sync bei Verbindung"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>
            </Frame>

            <!-- Offline Indicator -->
            <Frame Padding="8"
                   IsVisible="{Binding IsOfflineMode}"
                   BackgroundColor="{StaticResource Warning}"
                   CornerRadius="0"
                   BorderColor="Transparent">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="&#x26A0;" FontSize="16"/>
                    <Label Text="Offline-Modus - Gecachte Daten"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Status Message with Retry -->
            <Frame Padding="10"
                   IsVisible="{Binding HasStatusMessage}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource THWBlueSurface}, Dark={StaticResource THWBlueSurfaceDark}}"
                   CornerRadius="0"
                   BorderColor="Transparent">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"/>
                    <Button Grid.Column="1"
                            Text="Erneut"
                            IsVisible="{Binding CanRetry}"
                            Command="{Binding RefreshTicketsCommand}"
                            BackgroundColor="{StaticResource THWBlue}"
                            TextColor="White"
                            FontSize="11"
                            Padding="10,5"
                            CornerRadius="12"
                            HeightRequest="30"
                            MinimumHeightRequest="30"/>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
