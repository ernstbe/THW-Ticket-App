<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:THWTicketApp.Models"
             x:Class="THWTicketApp.TicketPage">
       <VerticalStackLayout Padding="30"
                            Spacing="20">
              <Label Text="Tickets"
                     FontSize="24"
                     HorizontalOptions="Center"/>
              <CollectionView x:Name="TicketsCollectionView"
                              ItemsSource="{Binding Tickets}"
                              SelectionMode="Single">
                     <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Ticket">
                                   <Grid Padding="10">
                                          <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto"/>
                                                 <RowDefinition Height="Auto"/>
                                          </Grid.RowDefinitions>
                                          <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                                 <ColumnDefinition Width="*"/>
                                          </Grid.ColumnDefinitions>
                                          <Label Grid.Column="0"
                                                 Text="{Binding Status.Name, StringFormat='Status: {0}'}"/>
                                          <Label Grid.Column="1"
                                                 Text="{Binding Type.Name, StringFormat='Art: {0}'}"/>
                                          <Label Grid.Column="2"
                                                 Text="{Binding Subject, StringFormat='Titel: {0}'}"
                                                 FontAttributes="Bold"/>
                                          <Label Grid.Column="3"
                                                 Text="{Binding Priority.Name, StringFormat='Wichtigkeit: {0}'}"/>
                                          <Label Grid.Column="4"
                                                 Text="{Binding Owner.Fullname, StringFormat='Ersteller: {0}'}"/>
                                          <Label Grid.Column="5"
                                                 Text="{Binding Assignee.Fullname, StringFormat='Zugewiesen: {0}'}"/>
                                          <Label Grid.Column="6"
                                                 Text="{Binding Date, StringFormat='Erstellt Am: {0}'}"/>
                                          <!-- Show ticket ID for debugging -->
                                          <Label Grid.Column="7"
                                                 Text="{Binding Id, StringFormat='Id: {0}'}"
                                                 FontSize="10"
                                                 TextColor="Gray"/>
                                   </Grid>
                            </DataTemplate>
                     </CollectionView.ItemTemplate>
              </CollectionView>
              <Button Grid.Column="0"
                      Grid.Row="1"
                      Text="Tickets neu abholen"
                      Command="{Binding RefreshTicketsAsync}"/>
              <!-- <Entry x:Name="NewTicketTitleEntry"
                     Placeholder="New Ticket Title"/>
              <Entry x:Name="NewTicketDescEntry"
                     Placeholder="New Ticket Description"/>
              <Entry x:Name="AssignUserIdEntry"
                     Placeholder="Assign to User ID"
                     Keyboard="Numeric"/>
              <Button Text="Add Ticket"
                      Command="{Binding OnAddTicketClicked}"/>
              <Label Text="{Binding StatusMessage}"
                     TextColor="Green"/> -->
       </VerticalStackLayout>
</ContentPage>
