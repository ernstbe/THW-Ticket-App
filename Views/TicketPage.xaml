<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:THWTicketApp.Models"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             x:Class="THWTicketApp.TicketPage"
             x:DataType="viewmodels:TicketPageViewModel"
             Title="Tickets">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          BackgroundColor="{StaticResource PageBackground}">

        <!-- Header with THW-blue background -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource HeaderBackground}"
              Padding="15,10"
              ColumnDefinitions="*,Auto">
            <!-- Search bar on white background -->
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="5,0">
                <SearchBar Placeholder="Suchen..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent"
                           CancelButtonColor="{StaticResource THWBlue}"/>
            </Border>
            <ImageButton Grid.Column="1"
                         Source="settings.png"
                         WidthRequest="40"
                         HeightRequest="40"
                         Command="{Binding ShowSettingsCommand}"
                         BackgroundColor="Transparent"
                         Margin="10,0,0,0"/>
        </Grid>

        <!-- Filter Chips -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="15,10"
                                   Spacing="8">
                <Button Text="Alle"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="all"
                        BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=all}"/>
                <Button Text="Offen"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="open"
                        BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=open}"/>
                <Button Text="Ausstehend"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="pending"
                        BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=pending}"/>
                <Button Text="Geschlossen"
                        Style="{StaticResource FilterChipStyle}"
                        Command="{Binding FilterCommand}"
                        CommandParameter="closed"
                        BackgroundColor="{Binding ActiveFilter, Converter={StaticResource FilterColorConverter}, ConverterParameter=closed}"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Ticket List with Pull-to-Refresh -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshTicketsCommand}"
                     RefreshColor="{StaticResource THWBlue}">
            <CollectionView x:Name="TicketsCollectionView"
                            ItemsSource="{Binding FilteredTickets}"
                            SelectionMode="Single"
                            EmptyView="Keine Ergebnisse">

                <!-- Loading indicator -->
                <CollectionView.Header>
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource THWBlue}"
                                       HeightRequest="50"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ticket">
                        <!-- Ticket Card with left priority bar (Trudesk-style) -->
                        <Border Margin="10,5"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource CardBackground}">
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,2"
                                        Radius="6"
                                        Opacity="0.1"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="5,*">
                                <!-- Left Priority Color Bar -->
                                <BoxView Grid.Column="0"
                                         BackgroundColor="{Binding Priority.HtmlColor}"
                                         WidthRequest="5"/>

                                <!-- Ticket Content -->
                                <Grid Grid.Column="1"
                                      Padding="15"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto">

                                    <!-- Title -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Subject}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource Gray900}"
                                           LineBreakMode="TailTruncation"/>

                                    <!-- Status Badge -->
                                    <Frame Grid.Row="0" Grid.Column="1"
                                           BackgroundColor="{Binding Status.HtmlColor}"
                                           Padding="10,4"
                                           CornerRadius="12"
                                           HasShadow="False"
                                           BorderColor="Transparent">
                                        <Label Text="{Binding Status.Name}"
                                               TextColor="White"
                                               FontSize="11"
                                               FontAttributes="Bold"/>
                                    </Frame>

                                    <!-- Type and Priority -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2"
                                                           Spacing="15"
                                                           Margin="0,8,0,0">
                                        <Label TextColor="{StaticResource Gray500}" FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Typ: " FontAttributes="Bold"/>
                                                    <Span Text="{Binding Type.Name}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label TextColor="{Binding Priority.HtmlColor}" FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Priorität: " FontAttributes="Bold"/>
                                                    <Span Text="{Binding Priority.Name}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <!-- Assignee and Date -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2"
                                                           Spacing="15"
                                                           Margin="0,5,0,0">
                                        <Label TextColor="{StaticResource Gray400}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Zuständig: "/>
                                                    <Span Text="{Binding Assignee.Fullname, TargetNullValue='Kein Benutzer zugewiesen'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label TextColor="{StaticResource Gray400}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Erstellt: "/>
                                                    <Span Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Floating Action Button -->
        <Button Grid.Row="2"
                Text="+"
                FontSize="24"
                FontAttributes="Bold"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Command="{Binding ShowAddTicketCommand}"
                BackgroundColor="{StaticResource THWBlue}"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,20">
            <Button.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.25"/>
            </Button.Shadow>
        </Button>

        <!-- Status Bar -->
        <VerticalStackLayout Grid.Row="3">
            <!-- Offline Indicator -->
            <Frame Padding="8"
                   IsVisible="{Binding IsOfflineMode}"
                   BackgroundColor="{StaticResource Warning}"
                   CornerRadius="0"
                   BorderColor="Transparent">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="&#x26A0;" FontSize="16"/>
                    <Label Text="Offline-Modus - Gecachte Daten"
                           TextColor="{StaticResource Gray900}"
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Frame Padding="10"
                   IsVisible="{Binding HasStatusMessage}"
                   BackgroundColor="{StaticResource THWBlueSurface}"
                   CornerRadius="0"
                   BorderColor="Transparent">
                <Label Text="{Binding StatusMessage}"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource THWBlueDark}"/>
            </Frame>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
