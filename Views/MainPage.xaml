<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             xmlns:models="clr-namespace:THWTicketApp.Models"
             x:Class="THWTicketApp.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBackground}, Dark={StaticResource HeaderBackgroundDark}}"
              Padding="20,15"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="THW Ticket System"
                       FontSize="12"
                       TextColor="#B3CCFF"/>
                <Label Text="{Binding WelcomeMessage}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource HeaderText}"/>
            </VerticalStackLayout>

            <!-- Notification Bell -->
            <Grid Grid.Column="1" VerticalOptions="Center">
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="Transparent"
                        Padding="8"
                        WidthRequest="44"
                        HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToNotificationsCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#x1F514;"
                           FontSize="22"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>
                <!-- Unread badge -->
                <Frame IsVisible="{Binding HasUnreadNotifications}"
                       BackgroundColor="{StaticResource Danger}"
                       CornerRadius="9"
                       Padding="5,1"
                       HasShadow="False"
                       BorderColor="Transparent"
                       HorizontalOptions="End"
                       VerticalOptions="Start"
                       Margin="0,-2,-2,0">
                    <Label Text="{Binding UnreadNotificationCount}"
                           TextColor="White"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </Frame>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource THWBlue}"
                                   HeightRequest="40"/>

                <!-- Error Banner with Retry -->
                <Frame Padding="10"
                       IsVisible="{Binding HasError}"
                       BackgroundColor="{StaticResource Warning}"
                       CornerRadius="8"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Erneut"
                                Command="{Binding LoadDashboardCommand}"
                                BackgroundColor="{StaticResource THWBlue}"
                                TextColor="White"
                                FontSize="11"
                                Padding="10,5"
                                CornerRadius="12"
                                HeightRequest="30"
                                MinimumHeightRequest="30"/>
                    </Grid>
                </Frame>

                <!-- Statistics Cards -->
                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="10">

                    <!-- Total Tickets -->
                    <Frame Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardStyle}"
                           BorderColor="Transparent"
                           Padding="12">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding TotalTickets}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource THWBlue}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Gesamt"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Open Tickets -->
                    <Frame Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardStyle}"
                           BorderColor="Transparent"
                           Padding="12">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding OpenTickets}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusNew}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Offen"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Pending Tickets -->
                    <Frame Grid.Row="0" Grid.Column="2"
                           Style="{StaticResource CardStyle}"
                           BorderColor="Transparent"
                           Padding="12">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding PendingTickets}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusPending}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Ausstehend"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- My Tickets -->
                    <Frame Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardStyle}"
                           BorderColor="Transparent"
                           Padding="12">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding MyTickets}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Meine"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Overdue Tickets -->
                    <Frame Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardStyle}"
                           BorderColor="Transparent"
                           Padding="12">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding OverdueTickets}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Überfällig"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Closed Tickets -->
                    <Frame Grid.Row="1" Grid.Column="2"
                           Style="{StaticResource CardStyle}"
                           BorderColor="Transparent"
                           Padding="12">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding ClosedTickets}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusClosed}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Geschlossen"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Tickets per Group -->
                <Frame Style="{StaticResource CardStyle}"
                       BorderColor="Transparent"
                       Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tickets pro Gruppe"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0"/>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <CollectionView ItemsSource="{Binding TicketsPerGroup}">
                            <CollectionView.EmptyView>
                                <Label Text="Keine Gruppen vorhanden."
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,10"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:GroupTicketCount">
                                    <Grid Padding="5,6" ColumnDefinitions="*,Auto,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding GroupName}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                               VerticalOptions="Center"/>
                                        <Frame Grid.Column="1"
                                               BackgroundColor="{StaticResource StatusNew}"
                                               Padding="8,3"
                                               CornerRadius="10"
                                               HasShadow="False"
                                               BorderColor="Transparent"
                                               Margin="5,0">
                                            <Label Text="{Binding Open, StringFormat='{0} offen'}"
                                                   TextColor="White"
                                                   FontSize="11"
                                                   FontAttributes="Bold"/>
                                        </Frame>
                                        <Label Grid.Column="2"
                                               Text="{Binding Total, StringFormat='{0} gesamt'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Quick Actions Row 1 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Alle Tickets"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NavigateToTicketsCommand}"/>
                    <Button Grid.Column="1"
                            Text="Neues Ticket"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NavigateToAddTicketCommand}"/>
                </Grid>

                <!-- Quick Actions Row 2 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Kanban Board"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NavigateToKanbanCommand}"/>
                    <Button Grid.Column="1"
                            Text="Team-Dashboard"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NavigateToTeamDashboardCommand}"/>
                </Grid>

                <!-- Recent Tickets -->
                <Frame Style="{StaticResource CardStyle}"
                       BorderColor="Transparent"
                       Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Zuletzt bearbeitet"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0"/>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <CollectionView ItemsSource="{Binding RecentTickets}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnRecentTicketSelected">
                            <CollectionView.EmptyView>
                                <Label Text="Keine Tickets vorhanden."
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,10"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Ticket">
                                    <Grid Padding="5,8" ColumnDefinitions="5,*,Auto">
                                        <!-- Priority Color Bar -->
                                        <BoxView Grid.Column="0"
                                                 BackgroundColor="{Binding Priority.HtmlColor}"
                                                 WidthRequest="5"
                                                 CornerRadius="2"/>

                                        <!-- Ticket Info -->
                                        <VerticalStackLayout Grid.Column="1" Padding="10,0" Spacing="2">
                                            <Label Text="{Binding Subject}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Updated, StringFormat='{0:dd.MM.yyyy HH:mm}'}"/>
                                                        <Span Text=" - "/>
                                                        <Span Text="{Binding Assignee.Fullname, TargetNullValue='Nicht zugewiesen'}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Status Badge -->
                                        <Frame Grid.Column="2"
                                               BackgroundColor="{Binding Status.HtmlColor}"
                                               Padding="8,3"
                                               CornerRadius="10"
                                               HasShadow="False"
                                               BorderColor="Transparent"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding Status.Name}"
                                                   TextColor="White"
                                                   FontSize="10"
                                                   FontAttributes="Bold"/>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Pending Sync Banner -->
                <Frame Padding="10"
                       IsVisible="{Binding HasPendingActions}"
                       BackgroundColor="#FFF3E0"
                       CornerRadius="8"
                       BorderColor="Transparent"
                       HasShadow="False">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="&#x1F504;" FontSize="14" VerticalOptions="Center"/>
                        <Label TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding PendingActionsCount}"/>
                                    <Span Text=" ausstehende Aktion(en) warten auf Synchronisation"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Sync Conflicts Banner -->
                <Frame Padding="10"
                       IsVisible="{Binding HasConflicts}"
                       BackgroundColor="#FFEBEE"
                       CornerRadius="8"
                       BorderColor="{StaticResource Danger}"
                       HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToConflictsCommand}"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="&#x26A0;" FontSize="16" VerticalOptions="Center"/>
                        <Label TextColor="#C62828"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ConflictCount}"/>
                                    <Span Text=" Sync-Konflikt(e) — Tippen zum Lösen"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Logout -->
                <Button Text="Abmelden"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalOptions="Center"
                        Margin="0,5,0,20"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
