<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             xmlns:converters="clr-namespace:THWTicketApp.Converters"
             x:Class="THWTicketApp.LoginPage"
             x:DataType="viewmodels:LoginPageViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <!-- Logo und Header -->
            <VerticalStackLayout Spacing="15" Margin="0,0,0,20">
                <Image Source="thw_logo.png"
                       HeightRequest="100"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>
                <Label Text="THW Ticket App"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                <Label Text="Melden Sie sich an, um fortzufahren"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Gray500}"/>
            </VerticalStackLayout>

            <!-- Login-Formular -->
            <Frame Padding="20" CornerRadius="15"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="20">

                    <!-- Benutzername -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Benutzername"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Frame Padding="0" CornerRadius="8" BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                            <Entry Placeholder="Benutzername eingeben"
                                   Text="{Binding Username}"
                                   Keyboard="Text"
                                   ReturnType="Next"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{DynamicResource Gray400}"
                                   BackgroundColor="Transparent"
                                   Margin="15,5"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Passwort -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Passwort"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Frame Padding="0" CornerRadius="8" BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                            <Entry Placeholder="Passwort eingeben"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{DynamicResource Gray400}"
                                   BackgroundColor="Transparent"
                                   Margin="15,5"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Login-Button -->
                    <Button Text="Anmelden"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            Margin="0,10,0,0"/>

                    <!-- Ladeindikator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{DynamicResource Primary}"
                                       HeightRequest="30"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Status-Meldung -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{DynamicResource Danger}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}"
                   IsVisible="{Binding LoginStatus, Converter={StaticResource StringToBoolConverter}}">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="⚠️" FontSize="16"/>
                    <Label Text="{Binding LoginStatus}"
                           TextColor="{DynamicResource Danger}"
                           FontSize="14"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Footer -->
            <VerticalStackLayout Spacing="5" Margin="0,20,0,0">
                <Label Text="Technisches Hilfswerk"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Gray400}"/>
                <Label Text="© 2024 THW Ticket System"
                       FontSize="11"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource Gray400}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
