<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="THWTicketApp.LoginPage"
             Shell.NavBarIsVisible="False">

    <!-- Full-page THW-Blue background -->
    <Grid BackgroundColor="#003399">
        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="0"
                                 Padding="30"
                                 VerticalOptions="Center">

                <!-- THW Logo -->
                <Image Source="thw_logo.svg"
                       HeightRequest="100"
                       Aspect="AspectFit"
                       Margin="0,0,0,15"
                       SemanticProperties.Description="THW Logo"/>

                <!-- App Title -->
                <Label Text="THW Ticket System"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,5"/>

                <Label Text="Technisches Hilfswerk"
                       FontSize="14"
                       TextColor="#B3CCFF"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,30"/>

                <!-- White Login Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="0,4"
                                Radius="12"
                                Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="15">

                        <Label Text="Anmelden"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#002266"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,10"/>

                        <!-- auth.login / common.username -->
                        <Label Text="Benutzername"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#404040"
                               Margin="0,5,0,2"/>
                        <Border Stroke="#E0E0E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,0"
                                BackgroundColor="#F7F8FA">
                            <Entry Placeholder="Benutzername"
                                   Text="{Binding Username}"
                                   TextColor="#212121"
                                   PlaceholderColor="#919191"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <!-- Password -->
                        <Label Text="Passwort"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#404040"
                               Margin="0,5,0,2"/>
                        <Border Stroke="#E0E0E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,0"
                                BackgroundColor="#F7F8FA">
                            <Entry Placeholder="Passwort"
                                   IsPassword="True"
                                   Text="{Binding Password}"
                                   TextColor="#212121"
                                   PlaceholderColor="#919191"
                                   BackgroundColor="Transparent"/>
                        </Border>

                        <!-- Login Button -->
                        <Button Text="Anmelden"
                                BackgroundColor="#003399"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="20,12"
                                MinimumHeightRequest="48"
                                Command="{Binding LoginCommand}"
                                Margin="0,10,0,0"/>

                        <!-- Status Text -->
                        <Label Text="{Binding LoginStatus}"
                               TextColor="#E74C3C"
                               HorizontalTextAlignment="Center"
                               FontSize="13"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
