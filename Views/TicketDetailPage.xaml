<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mdv="clr-namespace:Plugin.Maui.MarkdownView;assembly=Plugin.Maui.MarkdownView"
             x:Class="THWTicketApp.Views.TicketDetailPage"
             Title="Ticket-Details">

    <ScrollView BackgroundColor="{StaticResource PageBackground}">
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Header Card: Title + Status Badge -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding Ticket.Subject}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource THWBlueDark}"
                           LineBreakMode="WordWrap"/>
                    <Frame Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource StatusBadgeStyle}"
                           BackgroundColor="{Binding Ticket.Status.HtmlColor}"
                           BorderColor="Transparent"
                           VerticalOptions="Start">
                        <Label Text="{Binding Ticket.Status.Name}"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold"/>
                    </Frame>
                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding Ticket.Issue}"
                           TextColor="{StaticResource Gray600}"
                           FontSize="14"
                           Margin="0,10,0,0"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </Frame>

            <!-- Info Cards: Details Grid -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ticket-Details"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <!-- Status -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Status:"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Status.Name}"
                               TextColor="{Binding Ticket.Status.HtmlColor}"
                               FontAttributes="Bold"/>
                    </Grid>

                    <!-- Priority -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Priorität:"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Priority.Name}"
                               TextColor="{Binding Ticket.Priority.HtmlColor}"
                               FontAttributes="Bold"/>
                    </Grid>

                    <!-- Creator -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Ersteller:"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Owner.Fullname}"/>
                    </Grid>

                    <!-- Assignee -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Zuständig:"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Assignee.Fullname, TargetNullValue='Kein Benutzer zugewiesen'}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Assign Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Zuweisen an"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <Picker x:Name="AssigneePicker"
                            Title="Zuständigen setzen"
                            ItemsSource="{Binding Users}"
                            TitleColor="{StaticResource THWBlue}"
                            ItemDisplayBinding="{Binding Fullname}"
                            SelectedItem="{Binding SelectedAssignee}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Zuweisen an"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AssignCommand}"/>
                        <Button Grid.Column="1"
                                Text="Löschen"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearAssigneeCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Add Comment Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kommentar hinzufügen"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <Border Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10"
                            BackgroundColor="{StaticResource PageBackground}">
                        <Editor Placeholder="Neuen Kommentar eingeben..."
                                Text="{Binding NewComment}"
                                HeightRequest="80"
                                BackgroundColor="Transparent"/>
                    </Border>

                    <Button Text="Kommentar posten"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCommentCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Edit Ticket Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bearbeiten"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <Label Text="Betreff" Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10,0"
                            BackgroundColor="{StaticResource PageBackground}">
                        <Entry Placeholder="Bearbeite Titel"
                               Text="{Binding EditSubject}"
                               BackgroundColor="Transparent"/>
                    </Border>

                    <Label Text="Beschreibung" Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10"
                            BackgroundColor="{StaticResource PageBackground}">
                        <Editor Placeholder="Bearbeite Beschreibung"
                                Text="{Binding EditIssue}"
                                HeightRequest="120"
                                BackgroundColor="Transparent"/>
                    </Border>

                    <Button Text="Bearbeitung speichern"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding EditCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Comments Section -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kommentare"
                           x:Name="CommentsHeader"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divider}"/>

                    <CollectionView ItemsSource="{Binding Ticket.Comments}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{StaticResource CardBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,5"
                                        BackgroundColor="{StaticResource PageBackground}">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Owner.Fullname}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource THWBlueDark}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray400}"/>
                                        </Grid>
                                        <Label TextType="Html"
                                               Text="{Binding Text}"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray600}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource StatusNew}"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
