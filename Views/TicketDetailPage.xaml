<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:THWTicketApp.Converters"
             x:Class="THWTicketApp.Views.TicketDetailPage"
             Title="Ticket Details"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">

    <ContentPage.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:TranslationConverter x:Key="TranslationConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Header: Ticket Number and Subject -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Ticket.Uid, StringFormat='Ticket #{0}'}"
                           FontSize="14"
                           TextColor="{DynamicResource Primary}"/>
                    <Label Text="{Binding Ticket.Subject}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Status and Priority Row -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Padding="10" CornerRadius="8"
                       BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                    <VerticalStackLayout>
                        <Label Text="Status" FontSize="12" TextColor="{DynamicResource Gray500}"/>
                        <Label Text="{Binding Ticket.Status.Name, Converter={StaticResource TranslationConverter}}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Padding="10" CornerRadius="8"
                       BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                    <VerticalStackLayout>
                        <Label Text="Priorität" FontSize="12" TextColor="{DynamicResource Gray500}"/>
                        <Label Text="{Binding Ticket.Priority.Name, Converter={StaticResource TranslationConverter}}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Details Section -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Details" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0" Text="Typ:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Ticket.Type.Name, Converter={StaticResource TranslationConverter}}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Gruppe:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Ticket.Group.Name}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Ersteller:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Ticket.Owner.Fullname}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Zugewiesen:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Ticket.Assignee.Fullname}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Dates Section -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Zeitangaben" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0" Text="Erstellt:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Ticket.Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Aktualisiert:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Ticket.Updated, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Fällig:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Ticket.DueDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Geschlossen:" TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Ticket.ClosedDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Description Section -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Beschreibung" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <Label Text="{Binding Ticket.Issue}" TextType="Html"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Tags Section -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}"
                   IsVisible="{Binding Ticket.Tags.Count, Converter={StaticResource IntToBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tags" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <FlexLayout BindableLayout.ItemsSource="{Binding Ticket.Tags}"
                                Wrap="Wrap" Direction="Row" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="8,4" Margin="0,0,5,5" CornerRadius="12"
                                       BackgroundColor="{DynamicResource Primary}" BorderColor="Transparent">
                                    <Label Text="{Binding Name}" FontSize="12" TextColor="White"/>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Actions Section -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Aktionen" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <!-- Status Change -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Status ändern:" FontSize="14" TextColor="{DynamicResource Gray500}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Picker Grid.Column="0"
                                    Title="Status wählen"
                                    ItemsSource="{Binding Statuses}"
                                    ItemDisplayBinding="{Binding TranslatedName}"
                                    SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Text="Ändern"
                                    Command="{Binding ChangeStatusCommand}"
                                    BackgroundColor="{DynamicResource Primary}"
                                    TextColor="White"
                                    Padding="15,5"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Assignee Change -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Zuweisen an:" FontSize="14" TextColor="{DynamicResource Gray500}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Picker Grid.Column="0"
                                    Title="Benutzer wählen"
                                    ItemsSource="{Binding Users}"
                                    ItemDisplayBinding="{Binding Fullname}"
                                    SelectedItem="{Binding SelectedAssignee}"/>
                            <Button Grid.Column="1" Text="Zuweisen"
                                    Command="{Binding AssignCommand}"
                                    BackgroundColor="{DynamicResource Primary}"
                                    TextColor="White"
                                    Padding="15,5"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Comments Section -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Ticket.Comments.Count, StringFormat='Kommentare ({0})'}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <CollectionView ItemsSource="{Binding Ticket.Comments}"
                                    HeightRequest="250">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10" Margin="0,5" CornerRadius="8"
                                       BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}"
                                       BorderColor="Transparent">
                                    <VerticalStackLayout Spacing="5">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Owner.Fullname}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                            <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12" TextColor="{DynamicResource Gray500}"/>
                                        </HorizontalStackLayout>
                                        <Label TextType="Html" Text="{Binding Text}"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Keine Kommentare vorhanden"
                                   TextColor="{DynamicResource Gray500}"
                                   HorizontalOptions="Center"
                                   Margin="0,20"/>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Add Comment -->
                    <BoxView HeightRequest="1" Color="{DynamicResource Gray300}" Margin="0,5"/>
                    <Label Text="Neuer Kommentar:" FontSize="14" TextColor="{DynamicResource Gray500}"/>
                    <Editor Placeholder="Kommentar eingeben..."
                            Text="{Binding NewComment}"
                            HeightRequest="80"
                            AutoSize="TextChanges"
                            BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}"/>
                    <Button Text="Kommentar hinzufügen"
                            Command="{Binding AddCommentCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{DynamicResource Primary}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{DynamicResource Primary}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
