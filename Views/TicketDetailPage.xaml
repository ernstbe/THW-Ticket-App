<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mdv="clr-namespace:Plugin.Maui.MarkdownView;assembly=Plugin.Maui.MarkdownView"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             xmlns:models="clr-namespace:THWTicketApp.Models"
             xmlns:data="clr-namespace:THWTicketApp.Data"
             x:Class="THWTicketApp.Views.TicketDetailPage"
             x:DataType="viewmodels:TicketDetailViewModel"
             Title="Ticket-Details">

    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Header Card: Title + Status Badge + Tags -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="0">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding Ticket.Subject}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"
                               LineBreakMode="WordWrap"/>
                        <Frame Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource StatusBadgeStyle}"
                               BackgroundColor="{Binding Ticket.Status.HtmlColor}"
                               BorderColor="Transparent"
                               VerticalOptions="Start">
                            <Label Text="{Binding Ticket.Status.Name}"
                                   TextColor="White"
                                   FontSize="11"
                                   FontAttributes="Bold"/>
                        </Frame>
                        <mdv:MarkdownView Grid.Row="1" Grid.ColumnSpan="2"
                                          MarkdownText="{Binding Ticket.Issue}"
                                          Margin="0,10,0,0"/>
                    </Grid>

                    <!-- Tags -->
                    <HorizontalStackLayout Spacing="5"
                                           Margin="0,10,0,0"
                                           BindableLayout.ItemsSource="{Binding Ticket.Tags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="8,3"
                                       CornerRadius="10"
                                       HasShadow="False"
                                       BorderColor="{StaticResource THWBlueLight}"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource THWBlueSurface}, Dark={StaticResource THWBlueSurfaceDark}}">
                                    <Label Text="{Binding Name}"
                                           FontSize="11"
                                           TextColor="{StaticResource THWBlue}"/>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Time Tracking Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Zeiterfassung"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0"/>
                        <Label Grid.Column="1"
                               Text="{Binding TotalTimeDisplay, StringFormat='Gesamt: {0}'}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <!-- Timer Display -->
                    <Label Text="{Binding TimerDisplay}"
                           FontSize="32"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"/>

                    <!-- Timer Description (visible when running) -->
                    <Entry IsVisible="{Binding IsTimerRunning}"
                           Placeholder="Beschreibung (optional)"
                           Text="{Binding TimeEntryDescription}"
                           FontSize="13"/>

                    <!-- Start/Stop Button -->
                    <Button Text="{Binding IsTimerRunning, Converter={StaticResource BoolToTimerTextConverter}}"
                            Command="{Binding ToggleTimerCommand}"
                            BackgroundColor="{Binding IsTimerRunning, Converter={StaticResource BoolToTimerColorConverter}}"
                            TextColor="White"
                            CornerRadius="8"
                            FontAttributes="Bold"/>

                    <!-- Time Entries List -->
                    <CollectionView ItemsSource="{Binding TimeEntries}"
                                    IsVisible="{Binding TimeEntries.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:TimeEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="4,4" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding StartTime, StringFormat='{0:dd.MM HH:mm}'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Description, TargetNullValue='-'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding DurationMinutes, StringFormat='{0:F0} min'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"
                                           VerticalOptions="Center"/>
                                    <Button Grid.Column="3"
                                            Text="&#x2716;"
                                            FontSize="9"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Padding="0"
                                            CornerRadius="12"
                                            BackgroundColor="{StaticResource Danger}"
                                            TextColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketDetailViewModel}}, Path=DeleteTimeEntryCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Linked Tickets Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Verknüpfte Tickets"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0"/>
                        <Button Grid.Column="1"
                                Text="+ Verknüpfen"
                                FontSize="12"
                                Padding="10,4"
                                CornerRadius="12"
                                HeightRequest="30"
                                MinimumHeightRequest="30"
                                BackgroundColor="{StaticResource THWBlue}"
                                TextColor="White"
                                Command="{Binding ToggleLinkPickerCommand}"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <!-- Link Picker -->
                    <VerticalStackLayout IsVisible="{Binding IsLinkPickerVisible}" Spacing="8">
                        <Picker Title="Ticket auswählen..."
                                ItemsSource="{Binding AvailableTicketsForLink}"
                                ItemDisplayBinding="{Binding Subject}"
                                SelectedItem="{Binding SelectedTicketToLink}"
                                FontSize="13"/>
                        <Picker Title="Verknüpfungstyp"
                                SelectedItem="{Binding SelectedLinkType}"
                                FontSize="13">
                            <Picker.Items>
                                <x:String>related</x:String>
                                <x:String>blocks</x:String>
                                <x:String>blocked_by</x:String>
                                <x:String>duplicate</x:String>
                            </Picker.Items>
                        </Picker>
                        <Button Text="Verknüpfen"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="13"
                                Padding="10,6"
                                HeightRequest="36"
                                MinimumHeightRequest="36"
                                Command="{Binding AddLinkedTicketCommand}"/>
                    </VerticalStackLayout>

                    <!-- Linked Tickets List -->
                    <CollectionView ItemsSource="{Binding LinkedTickets}">
                        <CollectionView.EmptyView>
                            <Label Text="Keine verknüpften Tickets"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:LinkedTicket">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="4,4" ColumnSpacing="8">
                                    <Frame Grid.Column="0"
                                           Padding="4,2"
                                           CornerRadius="6"
                                           HasShadow="False"
                                           BorderColor="{StaticResource THWBlueLight}"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource THWBlueSurface}, Dark={StaticResource THWBlueSurfaceDark}}">
                                        <Label Text="{Binding LinkType}"
                                               FontSize="9"
                                               TextColor="{StaticResource THWBlue}"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding LinkedTicketUid, StringFormat='#{0} '}" FontAttributes="Bold"/>
                                                <Span Text="{Binding LinkedTicketSubject}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Button Grid.Column="3"
                                            Text="&#x2716;"
                                            FontSize="9"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Padding="0"
                                            CornerRadius="12"
                                            BackgroundColor="{StaticResource Danger}"
                                            TextColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketDetailViewModel}}, Path=RemoveLinkedTicketCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Info Cards: Details Grid -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ticket-Details"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <!-- Status -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Status:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Status.Name}"
                               TextColor="{Binding Ticket.Status.HtmlColor}"
                               FontAttributes="Bold"/>
                    </Grid>

                    <!-- Priority -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Priorität:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Priority.Name}"
                               TextColor="{Binding Ticket.Priority.HtmlColor}"
                               FontAttributes="Bold"/>
                    </Grid>

                    <!-- Creator -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Ersteller:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Owner.Fullname}"/>
                    </Grid>

                    <!-- Assignee -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Zuständig:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Assignee.Fullname, TargetNullValue='Kein Benutzer zugewiesen'}"/>
                    </Grid>

                    <!-- Due Date -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15"
                          IsVisible="{Binding Ticket.DueDate, Converter={StaticResource DueDateVisibilityConverter}}">
                        <Label Grid.Column="0"
                               Text="Fällig:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.DueDate, StringFormat='{0:dd.MM.yyyy}'}"
                               TextColor="{Binding Ticket.DueDate, Converter={StaticResource DueDateColorConverter}}"
                               FontAttributes="Bold"/>
                    </Grid>

                    <!-- Created / Updated -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Erstellt:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0"
                               Text="Aktualisiert:"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               WidthRequest="100"/>
                        <Label Grid.Column="1"
                               Text="{Binding Ticket.Updated, StringFormat='{0:dd.MM.yyyy HH:mm}'}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Attachments Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Anhänge"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <CollectionView ItemsSource="{Binding Ticket.Attachments}">
                        <CollectionView.EmptyView>
                            <Label Text="Keine Anhänge vorhanden."
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,10"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Attachment">
                                <Grid Padding="5,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="&#x1F4CE;"
                                           FontSize="18"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"/>
                                        <Label FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Size, StringFormat='{0:N0} Bytes'}"/>
                                                    <Span Text=" - "/>
                                                    <Span Text="{Binding UploadDate, StringFormat='{0:dd.MM.yyyy}'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="&#x2B07;"
                                            FontSize="14"
                                            Padding="8,4"
                                            CornerRadius="6"
                                            BackgroundColor="{StaticResource THWBlue}"
                                            TextColor="White"
                                            HeightRequest="32"
                                            MinimumHeightRequest="32"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketDetailViewModel}}, Path=DownloadAttachmentCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Datei hochladen"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding UploadAttachmentCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Assign Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Zuweisen an"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Picker x:Name="AssigneePicker"
                            Title="Zuständigen setzen"
                            ItemsSource="{Binding Users}"
                            TitleColor="{StaticResource THWBlue}"
                            ItemDisplayBinding="{Binding Fullname}"
                            SelectedItem="{Binding SelectedAssignee}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Zuweisen an"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AssignCommand}"/>
                        <Button Grid.Column="1"
                                Text="Löschen"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearAssigneeCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Add Comment Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kommentar hinzufügen"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <!-- Quick Reply Templates -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Picker Grid.Column="0"
                                Title="Schnellantwort wählen..."
                                ItemsSource="{Binding QuickReplyTemplates}"
                                SelectedItem="{Binding SelectedQuickReply}"
                                FontSize="13"/>
                        <Button Grid.Column="1"
                                Text="&#x2699;"
                                FontSize="16"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                CornerRadius="18"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                Command="{Binding ToggleTemplateEditorCommand}"/>
                    </Grid>

                    <!-- Template Editor (collapsible) -->
                    <Frame IsVisible="{Binding IsTemplateEditorVisible}"
                           Padding="10"
                           CornerRadius="8"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                           BorderColor="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Vorlagen verwalten"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0"
                                       Placeholder="Neue Vorlage..."
                                       Text="{Binding NewTemplateName}"
                                       FontSize="12"/>
                                <Button Grid.Column="1"
                                        Text="+"
                                        FontSize="14"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"
                                        CornerRadius="18"
                                        BackgroundColor="{StaticResource THWBlue}"
                                        TextColor="White"
                                        Command="{Binding AddTemplateCommand}"/>
                            </Grid>
                            <CollectionView ItemsSource="{Binding QuickReplyTemplates}"
                                            HeightRequest="120">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" Padding="4,2">
                                            <Label Grid.Column="0"
                                                   Text="{Binding .}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>
                                            <Button Grid.Column="1"
                                                    Text="&#x2716;"
                                                    FontSize="10"
                                                    WidthRequest="28"
                                                    HeightRequest="28"
                                                    Padding="0"
                                                    CornerRadius="14"
                                                    BackgroundColor="{StaticResource Danger}"
                                                    TextColor="White"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketDetailViewModel}}, Path=RemoveTemplateCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                        <Editor Placeholder="Neuen Kommentar eingeben... (@ für Erwähnung)"
                                Text="{Binding NewComment}"
                                HeightRequest="80"
                                BackgroundColor="Transparent"/>
                    </Border>

                    <!-- @Mention Suggestions -->
                    <Frame IsVisible="{Binding IsMentionPopupVisible}"
                           Padding="8"
                           CornerRadius="8"
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSurface}}"
                           BorderColor="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                           HasShadow="True">
                        <CollectionView ItemsSource="{Binding MentionSuggestions}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:User">
                                    <Grid Padding="6,4" ColumnDefinitions="*,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TicketDetailViewModel}}, Path=InsertMentionCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Fullname}" FontAttributes="Bold"/>
                                                    <Span Text="{Binding Username, StringFormat=' @{0}'}"
                                                          TextColor="{StaticResource THWBlue}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>

                    <Button Text="Kommentar posten"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCommentCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Internal Notes Section -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Interne Notizen"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <CollectionView ItemsSource="{Binding Ticket.Notes}">
                        <CollectionView.EmptyView>
                            <Label Text="Keine Notizen vorhanden."
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,10"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{AppThemeBinding Light=#FFF3CD, Dark=#5C4D1A}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,5"
                                        BackgroundColor="{AppThemeBinding Light=#FFFDE7, Dark=#3A3520}">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Owner.Fullname}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                                        </Grid>
                                        <Label Text="{Binding Content}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add Note -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light=#FFFDE7, Dark=#3A3520}">
                        <Editor Placeholder="Interne Notiz hinzufügen..."
                                Text="{Binding NewNote}"
                                HeightRequest="60"
                                BackgroundColor="Transparent"/>
                    </Border>

                    <Button Text="Notiz speichern"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddNoteCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Edit Ticket Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bearbeiten"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Label Text="Betreff" Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                        <Entry Placeholder="Bearbeite Titel"
                               Text="{Binding EditSubject}"
                               BackgroundColor="Transparent"/>
                    </Border>

                    <Label Text="Beschreibung" Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                        <Editor Placeholder="Bearbeite Beschreibung"
                                Text="{Binding EditIssue}"
                                HeightRequest="120"
                                BackgroundColor="Transparent"/>
                    </Border>

                    <Label Text="Status" Style="{StaticResource FormLabelStyle}"/>
                    <Picker Title="Status auswählen"
                            ItemsSource="{Binding Statuses}"
                            TitleColor="{StaticResource THWBlue}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedStatus}"/>

                    <Label Text="Priorität" Style="{StaticResource FormLabelStyle}"/>
                    <Picker Title="Priorität auswählen"
                            ItemsSource="{Binding Priorities}"
                            TitleColor="{StaticResource THWBlue}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPriority}"/>

                    <Button Text="Bearbeitung speichern"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding EditCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Comments Section -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kommentare"
                           x:Name="CommentsHeader"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <CollectionView ItemsSource="{Binding Ticket.Comments}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,5"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Owner.Fullname}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                                        </Grid>
                                        <Label TextType="Html"
                                               Text="{Binding Text}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- History Section -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Verlauf"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <CollectionView ItemsSource="{Binding Ticket.History}">
                        <CollectionView.EmptyView>
                            <Label Text="Kein Verlauf vorhanden."
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,10"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnDefinitions="4,*">
                                    <!-- Timeline bar -->
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{StaticResource THWBlueLight}"
                                             WidthRequest="4"
                                             CornerRadius="2"/>

                                    <VerticalStackLayout Grid.Column="1" Padding="10,0" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Action}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Date, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                                        </Grid>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding Owner.Fullname}"
                                               FontSize="11"
                                               TextColor="{StaticResource THWBlue}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource StatusNew}"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
