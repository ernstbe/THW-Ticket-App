        <Label Text="{Binding Ticket.Owner.Fullname, StringFormat='Ersteller: {0}'}"/>
        <Label Text="{Binding Ticket.Assignee.Fullname, StringFormat='Zugewiesen: {0}'}"/>

        <Picker x:Name="AssigneePicker"
