<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             x:Class="THWTicketApp.Views.TeamDashboardPage"
             x:DataType="viewmodels:TeamDashboardViewModel"
             Title="Team-Dashboard">

    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Header -->
            <Label Text="Team-Dashboard"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,5"/>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource THWBlue}"/>

            <!-- Team Stats Overview Row 1 -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- Total Members -->
                <Frame Grid.Column="0" Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding TotalTeamMembers}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource THWBlue}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Mitglieder"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Avg Workload -->
                <Frame Grid.Column="1" Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding AverageWorkload}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#FF9800"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Tickets/Person"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Total Tickets (from server stats) -->
                <Frame Grid.Column="2" Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding TotalTickets}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource THWBlue}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Tickets (30T)"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Team Stats Overview Row 2 -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- Closed Tickets -->
                <Frame Grid.Column="0" Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding ClosedTickets}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Geschlossen"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Avg Response Time -->
                <Frame Grid.Column="1" Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding AvgResponseDisplay}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#FF9800"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Antwortzeit"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Overdue -->
                <Frame Grid.Column="2" Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding OverdueCount}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#E74C3C"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Überfällig"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Top Stats -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Meiste Anfragen" FontSize="11" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Label Text="{Binding TopRequester}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Meiste Zuweisungen" FontSize="11" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Label Text="{Binding TopAssignee}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Team Members List -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Teamauslastung"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <CollectionView ItemsSource="{Binding TeamMembers}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TeamMemberStats">
                                <Border Margin="0,4"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                                        StrokeThickness="1"
                                        Padding="12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                                    <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="10">
                                        <!-- Workload Color Bar -->
                                        <BoxView Grid.Column="0"
                                                 BackgroundColor="{Binding WorkloadColor}"
                                                 WidthRequest="5"
                                                 CornerRadius="2"/>

                                        <!-- Name and Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"/>
                                            <HorizontalStackLayout Spacing="12">
                                                <Label FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Offen: " FontAttributes="Bold"/>
                                                            <Span Text="{Binding OpenTickets}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Geschl.: " FontAttributes="Bold"/>
                                                            <Span Text="{Binding ClosedTickets}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Antwort: " FontAttributes="Bold"/>
                                                            <Span Text="{Binding AvgResponseDisplay}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Workload Badge -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding AssignedTickets}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding WorkloadColor}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Frame BackgroundColor="{Binding WorkloadColor}"
                                                   Padding="6,2"
                                                   CornerRadius="8"
                                                   HasShadow="False"
                                                   BorderColor="Transparent">
                                                <Label Text="{Binding WorkloadLabel}"
                                                       TextColor="White"
                                                       FontSize="9"
                                                       FontAttributes="Bold"/>
                                            </Frame>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
