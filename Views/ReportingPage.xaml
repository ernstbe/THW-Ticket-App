<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             xmlns:controls="clr-namespace:THWTicketApp.Controls"
             x:Class="THWTicketApp.Views.ReportingPage"
             x:DataType="viewmodels:ReportingViewModel"
             Title="Berichte">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBackground}, Dark={StaticResource HeaderBackgroundDark}}"
              Padding="15,10">
            <Label Text="Berichte &amp; Statistiken"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"/>
        </Grid>

        <!-- Loading -->
        <controls:SkeletonView Grid.Row="1"
                                IsVisible="{Binding IsLoading}"
                                SkeletonType="list"/>

        <ScrollView Grid.Row="1"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Weekly Trend -->
                <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ticket-Trend (letzte 8 Wochen)"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <!-- Legend -->
                        <HorizontalStackLayout Spacing="15" Margin="0,0,0,5">
                            <HorizontalStackLayout Spacing="4">
                                <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="2"
                                         BackgroundColor="{StaticResource THWBlue}"/>
                                <Label Text="Erstellt" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4">
                                <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="2"
                                         BackgroundColor="{StaticResource Success}"/>
                                <Label Text="Geschlossen" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <CollectionView ItemsSource="{Binding WeeklyTrend}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:WeeklyCount">
                                    <Grid ColumnDefinitions="50,*" RowDefinitions="Auto,Auto" Padding="0,3" RowSpacing="2">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding WeekLabel}"
                                               FontSize="11" VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,Auto">
                                            <BoxView Grid.Column="0" HeightRequest="14" CornerRadius="3"
                                                     WidthRequest="{Binding CreatedBarWidth}"
                                                     BackgroundColor="{StaticResource THWBlue}"
                                                     HorizontalOptions="Start"/>
                                            <Label Grid.Column="1" Text="{Binding Created}" FontSize="10"
                                                   Margin="4,0,0,0" VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto">
                                            <BoxView Grid.Column="0" HeightRequest="14" CornerRadius="3"
                                                     WidthRequest="{Binding ClosedBarWidth}"
                                                     BackgroundColor="{StaticResource Success}"
                                                     HorizontalOptions="Start"/>
                                            <Label Grid.Column="1" Text="{Binding Closed}" FontSize="10"
                                                   Margin="4,0,0,0" VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Resolution Time -->
                <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Bearbeitungszeit"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <!-- Average -->
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding AvgResolutionTime}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource THWBlue}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Durchschnitt" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <!-- Fastest -->
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding FastestResolution}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Schnellste" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <!-- Slowest -->
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding SlowestResolution}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource Danger}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Langsamste" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label FontSize="11" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Basierend auf "/>
                                    <Span Text="{Binding ResolvedCount}" FontAttributes="Bold"/>
                                    <Span Text=" gelösten Tickets"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- SLA Compliance -->
                <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="SLA-Einhaltung"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <!-- Big percentage -->
                        <Label Text="{Binding SlaComplianceText}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource THWBlue}"
                               HorizontalTextAlignment="Center" Margin="0,5"/>

                        <!-- SLA breakdown -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding SlaMetCount}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Eingehalten" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding SlaAtRiskCount}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource Warning}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Gefährdet" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding SlaBreachedCount}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource Danger}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Überschritten" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Priority Distribution -->
                <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Verteilung nach Priorität"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <CollectionView ItemsSource="{Binding PriorityDistribution}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PriorityStats">
                                    <Grid ColumnDefinitions="80,*,Auto" Padding="0,4" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Name}"
                                               FontSize="13" VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                        <BoxView Grid.Column="1" HeightRequest="18" CornerRadius="4"
                                                 WidthRequest="{Binding BarWidth}"
                                                 BackgroundColor="{Binding Color}"
                                                 HorizontalOptions="Start"/>
                                        <Label Grid.Column="2" Text="{Binding Count}"
                                               FontSize="13" FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Top Assignees -->
                <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent" Padding="15"
                       Margin="0,0,0,20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Top Bearbeiter"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                        <CollectionView ItemsSource="{Binding TopAssignees}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:AssigneeStats">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="0">
                                                <BoxView Grid.Column="0" HeightRequest="10" CornerRadius="2"
                                                         WidthRequest="{Binding BarWidth}"
                                                         BackgroundColor="{StaticResource THWBlue}"
                                                         HorizontalOptions="Start"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="1">
                                            <Label FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Open}" FontAttributes="Bold"
                                                              TextColor="{StaticResource StatusNew}"/>
                                                        <Span Text=" offen"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Closed}" FontAttributes="Bold"/>
                                                        <Span Text=" gelöst"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
