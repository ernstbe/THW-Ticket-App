<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             x:Class="THWTicketApp.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Einstellungen">

    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Page Header -->
            <Label Text="Einstellungen"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,5"/>

            <!-- Appearance Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Erscheinungsbild"
                           x:Name="AppearanceHeader"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Dark Mode"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDarkMode}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Benachrichtigungen"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Text="Über neue Tickets und Änderungen informieren"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsNotificationsEnabled}"/>
                    </Grid>

                    <!-- Language -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Sprache / Language"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Picker Grid.Column="1"
                                SelectedIndex="{Binding SelectedLanguageIndex}"
                                VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Deutsch</x:String>
                                <x:String>English</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- API Configuration Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="12">
                    <Label Text="API-Konfiguration"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Label Text="Server-URL"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                        <Entry Placeholder="http://localhost:8118/api/v1"
                               Text="{Binding ApiBaseUrl}"
                               Keyboard="Url"
                               BackgroundColor="Transparent"/>
                    </Border>

                    <Label Text="Verbindungs-Timeout (Sekunden)"
                           Style="{StaticResource FormLabelStyle}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                        <Entry Placeholder="30"
                               Text="{Binding ConnectionTimeout}"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"/>
                    </Border>

                    <Button Text="Einstellungen testen"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding TestConnectionCommand}"/>

                    <Label Text="{Binding ConnectionStatus}"
                           TextColor="{Binding ConnectionStatusColor}"
                           IsVisible="{Binding HasConnectionStatus}"
                           HorizontalTextAlignment="Center"
                           FontSize="13"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Cache Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Offline-Cache"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Offline-Caching aktivieren"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsOfflineCacheEnabled}"/>
                    </Grid>

                    <Label Text="Wenn aktiviert, werden Tickets lokal gespeichert und bei Verbindungsproblemen angezeigt."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>

                    <Label Text="{Binding CacheInfo}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                    <Button Text="Löschen"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                            CornerRadius="8"
                            Command="{Binding ClearCacheCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Security Card -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent"
                   IsVisible="{Binding IsBiometricSupported}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sicherheit"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Biometrische Anmeldung"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                            <Label Text="Fingerabdruck oder Gesichtserkennung verwenden"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsBiometricEnabled}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- About Card with THW Branding -->
            <Frame Style="{StaticResource CardStyle}" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Image Grid.Column="0"
                               Source="thw_logo.svg"
                               HeightRequest="50"
                               WidthRequest="50"
                               Aspect="AspectFit"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center">
                            <Label Text="THW Ticket App"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource THWBlueDark}, Dark={StaticResource THWBlueLight}}"/>
                            <Label Text="Technisches Hilfswerk"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}"/>

                    <Label Text="{Binding AppVersion, StringFormat='Version: {0}'}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           FontSize="13"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Save Button -->
            <Button Text="Speichern"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveSettingsCommand}"
                    Margin="0,5,0,0"/>

            <!-- Logout Button -->
            <Button Text="Abmelden"
                    x:Name="LogoutBtn"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding LogoutCommand}"
                    Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
