<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:THWTicketApp.ViewModels"
             xmlns:converters="clr-namespace:THWTicketApp.Converters"
             x:Class="THWTicketApp.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Einstellungen"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Header -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <HorizontalStackLayout Spacing="15">
                    <Label Text="⚙️" FontSize="32" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Einstellungen"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label Text="App-Konfiguration verwalten"
                               FontSize="14"
                               TextColor="{DynamicResource Gray500}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Erscheinungsbild -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🎨" FontSize="20"/>
                        <Label Text="Erscheinungsbild" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Frame Padding="15" CornerRadius="8" BorderColor="Transparent"
                           BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Label Grid.Column="0" Text="🌙" FontSize="20" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Dark Mode"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Label Text="Dunkles Farbschema verwenden"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray500}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IsDarkMode}"
                                    OnColor="{DynamicResource Primary}"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- API-Konfiguration -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🌐" FontSize="20"/>
                        <Label Text="API-Konfiguration" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Server-URL -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Server-URL" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Frame Padding="0" CornerRadius="8" BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                            <Entry Placeholder="http://localhost:8118/api/v1"
                                   Text="{Binding ApiBaseUrl}"
                                   Keyboard="Url"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{DynamicResource Gray400}"
                                   BackgroundColor="Transparent"
                                   Margin="15,10"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Timeout -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Verbindungs-Timeout (Sekunden)" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Frame Padding="0" CornerRadius="8" BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                            <Entry Placeholder="30"
                                   Text="{Binding ConnectionTimeout}"
                                   Keyboard="Numeric"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{DynamicResource Gray400}"
                                   BackgroundColor="Transparent"
                                   Margin="15,10"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Verbindung testen -->
                    <Button Text="🔗  Verbindung testen"
                            Command="{Binding TestConnectionCommand}"
                            BackgroundColor="{AppThemeBinding Light=#C8C8C8, Dark=#333333}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            CornerRadius="8"
                            HeightRequest="45"/>

                    <!-- Verbindungsstatus -->
                    <Frame Padding="12" CornerRadius="8"
                           BorderColor="{Binding ConnectionStatusColor}"
                           BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}"
                           IsVisible="{Binding HasConnectionStatus}">
                        <Label Text="{Binding ConnectionStatus}"
                               TextColor="{Binding ConnectionStatusColor}"
                               HorizontalTextAlignment="Center"
                               FontSize="14"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Cache -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="💾" FontSize="20"/>
                        <Label Text="Offline-Cache" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Frame Padding="15" CornerRadius="8" BorderColor="Transparent"
                           BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Label Grid.Column="0" Text="📴" FontSize="20" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Offline-Caching"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Label Text="Tickets lokal speichern"
                                       FontSize="12"
                                       TextColor="{DynamicResource Gray500}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IsOfflineCacheEnabled}"
                                    OnColor="{DynamicResource Primary}"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <Label Text="Wenn aktiviert, werden Tickets lokal gespeichert und bei Verbindungsproblemen angezeigt."
                           FontSize="12"
                           TextColor="{DynamicResource Gray400}"
                           Margin="0,0,0,5"/>

                    <Frame Padding="12" CornerRadius="8" BorderColor="Transparent"
                           BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2A2A2A}">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📊" FontSize="16"/>
                            <Label Text="{Binding CacheInfo}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <Button Text="🗑️  Cache leeren"
                            Command="{Binding ClearCacheCommand}"
                            BackgroundColor="{AppThemeBinding Light=#C8C8C8, Dark=#333333}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            CornerRadius="8"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Über die App -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="ℹ️" FontSize="20"/>
                        <Label Text="Über die App" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0" Text="App:"
                               TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="THW Ticket App"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Version:"
                               TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding AppVersion}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Entwickler:"
                               TextColor="{DynamicResource Gray500}"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="Technisches Hilfswerk"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Aktionen -->
            <Frame Padding="15" CornerRadius="10"
                   BorderColor="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#212121}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="⚡" FontSize="20"/>
                        <Label Text="Aktionen" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Speichern-Button -->
                    <Button Text="💾  Einstellungen speichern"
                            Command="{Binding SaveSettingsCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"/>

                    <!-- Abmelden -->
                    <Button Text="🚪  Abmelden"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="{DynamicResource Danger}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Footer Spacing -->
            <BoxView HeightRequest="20" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
